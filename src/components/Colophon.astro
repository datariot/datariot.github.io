---
// minimal warm-modern footer
const year = new Date().getFullYear();
---

<footer id="contact" class="colophon" aria-label="Contact and colophon">
  <div>
    <p class="colophon__brand" aria-label="DataRiot">
      <span aria-hidden="true">Data<span class="riot">Riot</span></span>
    </p>
    <p>
      The working notebook of David Allen. Systems software from Boulder, Colorado.
      No analytics, no trackers, no newsletter popovers.
    </p>
    <p class="colophon__year">© {year} · All rights reserved</p>
  </div>

  <div>
    <h3>Elsewhere</h3>
    <ul>
      <li><a href="https://github.com/datariot" rel="noopener">GitHub</a></li>
      <li><a href="https://substack.com/@datariot" rel="noopener">Substack</a></li>
    </ul>
  </div>

  <div>
    <h3>This site</h3>
    <ul>
      <li>Set in Geist & Plus Jakarta Sans</li>
      <li>Built with Astro on GitHub Pages</li>
      <li><a href="https://github.com/datariot/datariot.github.io" rel="noopener">Source on GitHub ↗</a></li>
    </ul>
  </div>
</footer>
